# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/b2p_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=B2P.AI
VERSION=0.1.0

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Email Configuration (For automatic email processing and task creation)
# Leave SMTP_USER and SMTP_PASSWORD empty to disable automatic email processing

# For Gmail:
# 1. Enable 2-factor authentication in your Google account
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=993
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# For Outlook/Office 365:
# SMTP_HOST=outlook.office365.com
# SMTP_PORT=993
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-password

# Email Worker Configuration
# How often to check for new emails (in minutes)
EMAIL_CHECK_INTERVAL=5
# Default team ID for auto-assignment (optional, leave empty to use sender's team)
DEFAULT_TEAM_ID=
# Default user ID who "creates" tasks from emails (optional, leave empty to use sender)
DEFAULT_CREATED_BY=

# ML Model Configuration
NLP_MODEL_PATH=ml_models/nlp_task_extractor
SENTIMENT_MODEL_PATH=ml_models/sentiment_model
BURNOUT_MODEL_PATH=ml_models/burnout_predictor

# Logging
LOG_LEVEL=INFO
